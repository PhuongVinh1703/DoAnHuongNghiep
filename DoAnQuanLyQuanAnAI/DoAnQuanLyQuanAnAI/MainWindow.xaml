<Window x:Class="DoAnQuanLyQuanAnAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - POS Restaurant" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource LoginBackground}"
        FontFamily="Segoe UI">

    <Grid>
        <Border Background="{StaticResource SurfaceColor}" 
                Width="400" 
                CornerRadius="20" 
                Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.3" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="🍽️" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="POS Restaurant" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Hệ thống quản lý nhà hàng" FontSize="13" Foreground="{StaticResource TextSubColor}" HorizontalAlignment="Center" Margin="0,4,0,32"/>

                <Border x:Name="ErrorBox" Background="{StaticResource DangerLightColor}" BorderBrush="{StaticResource DangerColor}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,18" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Text="⚠️ Sai thông tin!" Foreground="{StaticResource DangerColor}" FontWeight="SemiBold" FontSize="13"/>
                </Border>

                <TextBlock Text="Tên đăng nhập" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSubColor}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername"  KeyDown="TxtInput_KeyDown" Background="{StaticResource SurfaceAltColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="14,11" FontSize="14" Foreground="{StaticResource TextColor}" Margin="0,0,0,16">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSubColor}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,24">
                    <PasswordBox x:Name="TxtPassword" KeyDown="TxtInput_KeyDown"
                                 Background="{StaticResource SurfaceAltColor}" 
                                 BorderBrush="{StaticResource BorderColor}" 
                                 BorderThickness="1" 
                                 Padding="14,11" 
                                 FontSize="14" 
                                 Foreground="{StaticResource TextColor}" 
                                 PasswordChanged="TxtPassword_PasswordChanged">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBox x:Name="TxtPasswordVisible"  KeyDown="TxtInput_KeyDown"
                             Background="{StaticResource SurfaceAltColor}" 
                             BorderBrush="{StaticResource BorderColor}" 
                             BorderThickness="1" 
                             Padding="14,11" 
                             FontSize="14" 
                             Foreground="{StaticResource TextColor}" 
                             Visibility="Collapsed">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button x:Name="BtnTogglePassword" 
                            Content="👁" 
                            Click="BtnTogglePassword_Click" 
                            Width="36" Height="36" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Margin="0,0,6,0" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand" 
                            FontSize="16" 
                            ToolTip="Hiện/ẩn mật khẩu"/>
                </Grid>
                <Button x:Name="BtnLogin" Content="🔐 Đăng nhập" Click="BtnLogin_Click" 
                        Background="{StaticResource PrimaryColor}" Foreground="White" 
                        FontSize="15" FontWeight="Bold" Padding="0,13" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

               
            </StackPanel>
        </Border>
    </Grid>
</Window>
<Window x:Class="DoAnQuanLyQuanAnAI.InvoiceDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết hóa đơn"
        Height="600" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f0f2f5"
        FontFamily="Segoe UI">
    <Grid>
        <!-- Header -->
        <Border VerticalAlignment="Top" Height="56" Background="#1e293b" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧾" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtInvoiceNo" Text="Chi tiết hóa đơn"
                           FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Margin="20,68,20,72" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
            </Border.Effect>
            <StackPanel>

                <!-- Thông tin hóa đơn -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock x:Name="TxtTableName"  FontSize="13" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtStaffName"  FontSize="13" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtPaidAt"     FontSize="13" Foreground="#475569"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="TxtPayMethod"  FontSize="13" Foreground="#475569"
                                   HorizontalAlignment="Right" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtBranchName" FontSize="13" Foreground="#475569"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>

                <!-- Tiêu đề danh sách món -->
                <TextBlock Text="Danh sách món đã gọi" FontSize="13" FontWeight="Bold"
                           Foreground="#1e293b" Margin="0,0,0,10"/>

                <!-- Bảng món ăn -->
                <DataGrid x:Name="DgItems" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#fafafa"
                          MaxHeight="240" CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"   Value="#f8fafc"/>
                            <Setter Property="Foreground"   Value="#64748b"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="FontSize"     Value="12"/>
                            <Setter Property="Padding"      Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Món ăn"     Binding="{Binding ItemName}"  Width="*"/>
                        <DataGridTextColumn Header="Đơn giá"    Binding="{Binding UnitPrice}" Width="120"/>
                        <DataGridTextColumn Header="SL"         Binding="{Binding Quantity}"  Width="50"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>

                <!-- Tổng tiền — dùng StackPanel thay vì Grid lồng nhau -->
                <StackPanel HorizontalAlignment="Right">
                    <Grid Width="280" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tạm tính:"
                                   FontSize="13" Foreground="#64748b"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSubtotal"
                                   FontSize="13" Foreground="#64748b"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Width="280" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VAT (8%):"
                                   FontSize="13" Foreground="#64748b"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtVat"
                                   FontSize="13" Foreground="#64748b"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="#f0fdf4" CornerRadius="8" Padding="16,10" Width="280">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TỔNG CỘNG:"
                                       FontSize="15" FontWeight="Bold" Foreground="#1e293b"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtTotal"
                                       FontSize="16" FontWeight="Bold" Foreground="#16a34a"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Nút đóng -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
            <Button Content="✕ Đóng" Click="BtnClose_Click"
                    Background="#f1f5f9" Foreground="#475569"
                    BorderThickness="0" Padding="24,10" FontSize="14" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>

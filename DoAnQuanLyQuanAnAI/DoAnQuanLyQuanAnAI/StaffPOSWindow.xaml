<Window x:Class="DoAnQuanLyQuanAnAI.StaffPOSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thu Ngân - POS Restaurant" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgColor}"
        FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource LoginBackground}" Grid.Row="0" Padding="20,0">
            <Grid>
                <TextBlock Text="🍽️ POS Restaurant" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStaffName" Text="👤 Nhân viên" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="🚪 Đăng xuất" Click="BtnLogout_Click" Background="#22ffffff" Foreground="White" BorderBrush="#44ffffff" Padding="15,6" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceColor}" Margin="10,10,5,10" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="🪑 Chọn bàn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextColor}" Margin="5,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TableList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="BtnTable_Click" Margin="5" Padding="10" Background="{Binding StatusBrush}" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TableName}" FontSize="14" FontWeight="Bold" Width="70" Foreground="White"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource SurfaceColor}" Margin="5,10,5,10" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📚 Thực đơn" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1" x:Name="TxtSearchMenu" Margin="16,0" Padding="10,8" FontSize="13"
                                 Background="{StaticResource SurfaceAltColor}" BorderBrush="{StaticResource BorderColor}" 
                                 BorderThickness="1" Foreground="{StaticResource TextColor}" VerticalContentAlignment="Center"
                                 TextChanged="TxtSearchMenu_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltColor}"/>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush TileMode="None" Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <StackPanel Background="Transparent">
                                                                <TextBlock Text="🔍 Tìm tên món..." Foreground="#94a3b8" FontSize="13" Margin="12,8,0,0"/>
                                                            </StackPanel>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Border Grid.Column="2" Background="{StaticResource PrimaryColor}" Padding="10,5" CornerRadius="6">
                            <TextBlock x:Name="TxtSelectedTable" Text="📍 Chưa chọn bàn" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
                        <StackPanel x:Name="CategoryBar" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MenuList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="150" Background="{StaticResource SurfaceAltColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Margin="5" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Emoji}" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextColor}" TextWrapping="Wrap" TextAlignment="Center" Height="36"/>
                                            <TextBlock Text="{Binding Price, StringFormat=\{0:N0\} đ}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center"/>
                                            <Button Content="＋ Thêm" Tag="{Binding}" Click="BtnAddItem_Click" Background="{StaticResource PrimaryColor}" Foreground="White" BorderThickness="0" Padding="0,6" Margin="0,10,0,0" FontSize="12" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceColor}" Margin="5,10,10,10" CornerRadius="10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltColor}" Padding="15" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                        <Grid>
                            <TextBlock Text="🛒 Đơn hàng" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearOrder" Content="🗑 Hủy đơn" Click="BtnClearOrder_Click" HorizontalAlignment="Right" Background="{StaticResource DangerColor}" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <ListView x:Name="OrderList" Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="10" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding LineTotal, StringFormat=\{0:N0\} đ}" Foreground="{StaticResource PrimaryColor}" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                        <Button Content="－" Tag="{Binding}" Click="BtnDecQty_Click" Width="25" Height="25" Background="{StaticResource SurfaceAltColor}" BorderThickness="0"/>
                                        <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Button Content="＋" Tag="{Binding}" Click="BtnIncQty_Click" Width="25" Height="25" Background="{StaticResource SurfaceAltColor}" BorderThickness="0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="✕ Xóa" Tag="{Binding}" Click="BtnRemoveItem_Click" Background="{StaticResource DangerLightColor}" Foreground="{StaticResource DangerColor}" BorderThickness="0" Height="25" FontSize="11" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceAltColor}" Padding="20" CornerRadius="0,0,10,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Tạm tính:" Foreground="{StaticResource TextSubColor}"/>
                                <TextBlock x:Name="TxtSubtotal" Text="0 đ" Foreground="{StaticResource TextSubColor}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="VAT (8%):" Foreground="{StaticResource TextSubColor}"/>
                                <TextBlock x:Name="TxtVat" Text="0 đ" Foreground="{StaticResource TextSubColor}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,5,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="TỔNG CỘNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextColor}"/>
                                <TextBlock x:Name="TxtTotal" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Right"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <RadioButton x:Name="RbCash" Content="Tiền mặt" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton x:Name="RbCard" Content="Thẻ" Margin="0,0,15,0"/>
                                <RadioButton x:Name="RbTransfer" Content="Chuyển khoản" Margin="0,0,15,0"/>
                                <RadioButton x:Name="RbQR" Content="📱 QR Code"/>
                            </StackPanel>

                            <Button x:Name="BtnCheckout" Content="💳 THANH TOÁN" Click="BtnCheckout_Click" Background="{StaticResource SuccessColor}" Foreground="White" FontSize="15" FontWeight="Bold" Padding="12" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="AlertBanner" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Background="#dc2626" Padding="20,14" Visibility="Collapsed" Panel.ZIndex="99" CornerRadius="0,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="HỆ THỐNG PHÁT HIỆN BẤT THƯỜNG" FontSize="12" FontWeight="Bold" Foreground="#fecaca" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtAlertBanner" Text="" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAlertCountdown" Text="Tự đóng sau 8s" FontSize="12" Foreground="#fecaca" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Border Background="#b91c1c" CornerRadius="6" Padding="12,6" Cursor="Hand" MouseLeftButtonDown="BtnDismissAlert_Click">
                            <TextBlock Text="✕ Đóng" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
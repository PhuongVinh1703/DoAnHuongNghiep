<Window x:Class="DoAnQuanLyQuanAnAI.OwnerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý - POS Restaurant" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#f0f2f5" FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f8fafc"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1e293b" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="POS Restaurant" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#334155" CornerRadius="4" Padding="10,3" Margin="16,0,0,0">
                        <TextBlock Text="Bảng điều khiển" FontSize="12" Foreground="#94a3b8"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOwnerName" Text="👤" Foreground="White"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBlock x:Name="TxtDateTime" Text="" Foreground="#94a3b8"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="🚪 Đăng xuất" Click="BtnLogout_Click"
                            Background="#334155" Foreground="White" BorderThickness="0"
                            Padding="16,7" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="18,14"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#64748b"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="B" Background="Transparent"
                                        BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="B" Property="BorderBrush" Value="#3b82f6"/>
                                        <Setter Property="Foreground" Value="#1e293b"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#f1f5f9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══ TAB 1: TỔNG QUAN ══ -->
            <TabItem Header="📊 Tổng quan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <!-- Filter chi nhánh -->
                        <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏢 Xem theo chi nhánh:" FontSize="13" Foreground="#64748b"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CbBranchDashboard" Width="200" Style="{StaticResource FilterCombo}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="CbBranchDashboard_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- 4 stat cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Background="#eff6ff" CornerRadius="8" Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Left">
                                        <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Doanh thu hôm nay" FontSize="13" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtTodayRevenue" Text="0 đ" FontSize="22" FontWeight="Bold" Foreground="#1e293b"/>
                                    <TextBlock x:Name="TxtInvoiceAvg" Text="Trung bình: 0 đ" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Background="#f0fdf4" CornerRadius="8" Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🧾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Hóa đơn hôm nay" FontSize="13" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtTodayInvoices" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1e293b"/>
                                    <TextBlock Text="hóa đơn đã thanh toán" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Margin="5,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Background="#fff7ed" CornerRadius="8" Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Left">
                                        <TextBlock Text="🪑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bàn đang phục vụ" FontSize="13" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtOccupiedTables" Text="0/0" FontSize="22" FontWeight="Bold" Foreground="#1e293b"/>
                                    <TextBlock Text="bàn đang có khách" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Border Background="#fef2f2" CornerRadius="8" Width="44" Height="44" Margin="0,0,0,12" HorizontalAlignment="Left">
                                        <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Cảnh báo chưa xử lý" FontSize="13" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtPendingAlerts" Text="0" FontSize="22" FontWeight="Bold" Foreground="#ef4444"/>
                                    <TextBlock Text="cần kiểm tra ngay" FontSize="12" Foreground="#94a3b8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" CornerRadius="12" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="🧾 Hóa đơn gần đây (20 mới nhất)" FontSize="15" FontWeight="Bold" Foreground="#1e293b"/>
                                    <Button Content="🔄 Làm mới" Click="BtnRefreshDashboard_Click"
                                            HorizontalAlignment="Right" Background="#f1f5f9"
                                            Foreground="#475569" BorderThickness="0" Padding="14,7" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <DataGrid x:Name="DgRecentInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                          Background="Transparent" BorderThickness="0"
                                          RowBackground="White" AlternatingRowBackground="#fafafa"
                                          Height="280" SelectionMode="Single" CanUserResizeRows="False">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Số HĐ"      Binding="{Binding InvoiceNo}"    Width="140"/>
                                        <DataGridTextColumn Header="Bàn"        Binding="{Binding TableName}"   Width="70"/>
                                        <DataGridTextColumn Header="Nhân viên"  Binding="{Binding StaffName}"   Width="150"/>
                                        <DataGridTextColumn Header="Chi nhánh"  Binding="{Binding BranchName}"  Width="120"/>
                                        <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TotalAmount}" Width="120"/>
                                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding PayMethod}"   Width="110"/>
                                        <DataGridTextColumn Header="Thời gian"  Binding="{Binding PaidAt}"      Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TAB 2: THỐNG KÊ ══ -->
            <TabItem Header="📈 Thống kê &amp; Biểu đồ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.07" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Từ ngày:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpChartFrom" Width="130" Margin="0,0,16,0" SelectedDateChanged="DpChart_Changed"/>
                                <TextBlock Text="Đến ngày:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DpChartTo" Width="130" Margin="0,0,16,0" SelectedDateChanged="DpChart_Changed"/>
                                <TextBlock Text="🏢 Chi nhánh:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CbBranchChart" Width="180" Style="{StaticResource FilterCombo}"
                                          DisplayMemberPath="DisplayName" Margin="0,0,16,0"
                                          SelectionChanged="CbBranchChart_Changed"/>
                                <Button Content="🔄 Xem biểu đồ" Click="BtnRefreshChart_Click"
                                        Background="#3b82f6" Foreground="White" BorderThickness="0"
                                        Padding="16,8" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="📉 Biểu đồ doanh thu" FontSize="15" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="ChartLegend" Orientation="Horizontal" Margin="0,0,0,8"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Canvas x:Name="ChartCanvas" Height="260" MinWidth="400"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="🔥 Top món bán chạy" FontSize="15" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,16"/>
                                    <ItemsControl x:Name="TopMenuList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Emoji}" FontSize="20" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1e293b"/>
                                                        <Border Background="#f1f5f9" CornerRadius="4" Height="6" Margin="0,4,8,0" HorizontalAlignment="Left" Width="{Binding BarWidth}">
                                                            <Border Background="#3b82f6" CornerRadius="4"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12" FontWeight="Bold" Foreground="#3b82f6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ TAB 3: NHÂN VIÊN ══ -->
            <TabItem Header="👥 Nhân viên">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👥 Nhân viên" FontSize="15" FontWeight="Bold" Foreground="#1e293b" VerticalAlignment="Center"/>
                                <Border Background="#eff6ff" CornerRadius="12" Padding="10,3" Margin="10,0,0,0">
                                    <TextBlock x:Name="TxtStaffCount" Text="0" FontSize="12" Foreground="#3b82f6" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Tìm theo tên -->
                                <TextBox x:Name="TxtSearchStaff" Width="180" Style="{StaticResource SearchBox}"
                                         Margin="0,0,8,0" TextChanged="TxtSearchStaff_TextChanged">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <!-- Lọc chi nhánh -->
                                <ComboBox x:Name="CbBranchStaff" Width="160" Style="{StaticResource FilterCombo}"
                                          DisplayMemberPath="DisplayName" Margin="0,0,8,0"
                                          SelectionChanged="CbBranchStaff_Changed"/>
                                <!-- Lọc vai trò -->
                                <ComboBox x:Name="CbRoleFilter" Width="140" Style="{StaticResource FilterCombo}"
                                          Margin="0,0,10,0" SelectionChanged="CbRoleFilter_Changed">
                                    <ComboBoxItem Content="— Tất cả vai trò —" Tag="" IsSelected="True"/>
                                    <ComboBoxItem Content="👑 Owner"     Tag="0"/>
                                    <ComboBoxItem Content="🏢 Quản lý"  Tag="2"/>
                                    <ComboBoxItem Content="👤 Nhân viên" Tag="1"/>
                                </ComboBox>
                                <Button Content="➕ Thêm tài khoản" Click="BtnAddAccount_Click"
                                        Background="#3b82f6" Foreground="White" BorderThickness="0"
                                        Padding="14,8" FontWeight="SemiBold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <DataGrid x:Name="DgStaff" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="White" AlternatingRowBackground="#fafafa"
                                  SelectionMode="Single" CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="50"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#eff6ff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Avatar"    Binding="{Binding Avatar}"    Width="55"/>
                                <DataGridTextColumn Header="Họ tên"    Binding="{Binding FullName}"  Width="160"/>
                                <DataGridTextColumn Header="Đăng nhập" Binding="{Binding Username}"  Width="120"/>
                                <DataGridTextColumn Header="SĐT"       Binding="{Binding Phone}"     Width="110"/>
                                <DataGridTextColumn Header="Giới tính" Binding="{Binding GenderText}" Width="80"/>
                                <DataGridTextColumn Header="Chi nhánh" Binding="{Binding BranchName}" Width="120"/>
                                <DataGridTextColumn Header="Vai trò"   Binding="{Binding RoleText}"  Width="100"/>
                                <DataGridTextColumn Header="Tham gia"  Binding="{Binding JoinDate}"  Width="100"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBg}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                                <Button Content="✏️ Sửa" Tag="{Binding}" Click="BtnEditStaff_Click"
                                                        Background="#eff6ff" Foreground="#3b82f6" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="🔑 MK" Tag="{Binding}" Click="BtnResetPassword_Click"
                                                        Background="#f1f5f9" Foreground="#475569" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="{Binding ToggleText}" Tag="{Binding}" Click="BtnToggleActive_Click"
                                                        Background="{Binding ToggleBg}" Foreground="White" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="🗑" Tag="{Binding}" Click="BtnDeleteStaff_Click"
                                                        Background="#fef2f2" Foreground="#ef4444" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ TAB 4: MÓN ĂN ══ -->
            <TabItem Header="🍽️ Món ăn">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍽️ Danh sách món" FontSize="15" FontWeight="Bold" Foreground="#1e293b" VerticalAlignment="Center"/>
                                <Border Background="#f0fdf4" CornerRadius="12" Padding="10,3" Margin="10,0,16,0">
                                    <TextBlock x:Name="TxtMenuCount" Text="0 món" FontSize="12" Foreground="#16a34a" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="Danh mục:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CbMenuFilter" Width="180" Style="{StaticResource FilterCombo}"
                                          SelectionChanged="CbMenuFilter_Changed"/>
                            </StackPanel>
                            <Button Content="➕ Thêm món" Click="BtnAddMenuItem_Click"
                                    HorizontalAlignment="Right"
                                    Background="#16a34a" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <DataGrid x:Name="DgMenuItems" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="White" AlternatingRowBackground="#fafafa"
                                  SelectionMode="Single" CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="48"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#f0fdf4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon"      Binding="{Binding Emoji}"        Width="55"/>
                                <DataGridTextColumn Header="Tên món"   Binding="{Binding Name}"         Width="180"/>
                                <DataGridTextColumn Header="Danh mục"  Binding="{Binding CategoryName}" Width="130"/>
                                <DataGridTextColumn Header="Giá"       Binding="{Binding PriceText}"    Width="110"/>
                                <DataGridTextColumn Header="Mô tả"     Binding="{Binding Description}"  Width="*"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding AvailableBg}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding AvailableText}" Foreground="{Binding AvailableFg}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Thao tác" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <Button Content="✏️ Sửa" Tag="{Binding}" Click="BtnEditMenuItem_Click"
                                                        Background="#eff6ff" Foreground="#3b82f6" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand" Margin="0,0,5,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="🗑 Xóa" Tag="{Binding}" Click="BtnDeleteMenuItem_Click"
                                                        Background="#fef2f2" Foreground="#ef4444" BorderThickness="0"
                                                        Padding="8,5" FontSize="12" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ TAB 5: LỊCH SỬ HÓA ĐƠN ══ -->
            <TabItem Header="🧾 Lịch sử hóa đơn">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <TextBlock Text="Từ:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpFrom" Width="130" Margin="0,0,12,0" SelectedDateChanged="DateFilter_Changed"/>
                                <TextBlock Text="Đến:" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="DpTo" Width="130" Margin="0,0,12,0" SelectedDateChanged="DateFilter_Changed"/>
                                <TextBlock Text="🏢" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbBranchInvoice" Width="150" Style="{StaticResource FilterCombo}"
                                          DisplayMemberPath="DisplayName" Margin="0,0,10,0"
                                          SelectionChanged="CbBranchInvoice_Changed"/>
                                <TextBlock Text="👤" FontSize="13" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CbFilterStaff" Width="150" Style="{StaticResource FilterCombo}" Margin="0,0,10,0"/>
                                <Button Content="🔍 Tìm" Click="BtnSearchInvoice_Click"
                                        Background="#3b82f6" Foreground="White" BorderThickness="0"
                                        Padding="14,7" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="↩" Click="BtnResetInvoiceFilter_Click"
                                        Background="#f1f5f9" Foreground="#475569" BorderThickness="0"
                                        Padding="14,7" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#f0fdf4" CornerRadius="8" Padding="14,7" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tổng: " FontSize="13" Foreground="#64748b" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtFilterTotal" Text="0 đ" FontSize="14"
                                                   FontWeight="Bold" Foreground="#16a34a" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#eff6ff" CornerRadius="8" Padding="14,7">
                                    <TextBlock x:Name="TxtInvoiceCount" Text="0 hóa đơn" FontSize="13"
                                               Foreground="#3b82f6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="White" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <DataGrid x:Name="DgInvoices" AutoGenerateColumns="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="White" AlternatingRowBackground="#fafafa"
                                  SelectionMode="Single" CanUserResizeRows="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Số HĐ"      Binding="{Binding InvoiceNo}"    Width="140"/>
                                <DataGridTextColumn Header="Bàn"        Binding="{Binding TableName}"   Width="70"/>
                                <DataGridTextColumn Header="Nhân viên"  Binding="{Binding StaffName}"   Width="140"/>
                                <DataGridTextColumn Header="Chi nhánh"  Binding="{Binding BranchName}"  Width="110"/>
                                <DataGridTextColumn Header="Tạm tính"   Binding="{Binding Subtotal}"    Width="110"/>
                                <DataGridTextColumn Header="VAT"        Binding="{Binding VatAmount}"   Width="90"/>
                                <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TotalAmount}" Width="120"/>
                                <DataGridTextColumn Header="Thanh toán" Binding="{Binding PayMethod}"   Width="110"/>
                                <DataGridTextColumn Header="Thời gian"  Binding="{Binding PaidAt}"      Width="140"/>
                                <DataGridTemplateColumn Header="Chi tiết" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🔍 Xem" Tag="{Binding}"
                                                    Click="BtnViewInvoiceDetail_Click"
                                                    Background="#eff6ff" Foreground="#3b82f6"
                                                    BorderThickness="0" Padding="8,4"
                                                    FontSize="12" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ TAB 6: CẢNH BÁO & LOG ══ -->
            <TabItem Header="🚨 Cảnh báo &amp; Log">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cảnh báo -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#fef2f2" CornerRadius="12,12,0,0" Padding="14,12">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ Cảnh báo bất thường" FontSize="14" FontWeight="Bold" Foreground="#991b1b"/>
                                        <Border Background="#fee2e2" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                                            <TextBlock x:Name="TxtAlertCount" Text="0" FontSize="12" Foreground="#ef4444" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="🔄 Retrain" Click="BtnRetrainModel_Click"
                                                Background="#7c3aed" Foreground="White" BorderThickness="0"
                                                Padding="10,5" FontSize="12" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="✅ Xử lý tất cả" Click="BtnResolveAll_Click"
                                                Background="#ef4444" Foreground="White" BorderThickness="0"
                                                Padding="10,5" FontSize="12" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Filter chi nhánh cho Alert -->
                            <Border Grid.Row="1" Padding="12,8" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢 Chi nhánh:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CbBranchAlert" Width="180" Style="{StaticResource FilterCombo}"
                                              DisplayMemberPath="DisplayName" SelectionChanged="CbBranchAlert_Changed"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="DgAlerts" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="White" AlternatingRowBackground="#fafafa"
                                      SelectionMode="Single" CanUserResizeRows="False">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Loại"       Binding="{Binding AlertTypeText}" Width="110"/>
                                    <DataGridTextColumn Header="Mức độ"     Binding="{Binding SeverityText}"  Width="80"/>
                                    <DataGridTextColumn Header="Nhân viên"  Binding="{Binding StaffName}"     Width="110"/>
                                    <DataGridTextColumn Header="Chi nhánh"  Binding="{Binding BranchName}"    Width="100"/>
                                    <DataGridTextColumn Header="Nội dung"   Binding="{Binding Message}"       Width="*"/>
                                    <DataGridTextColumn Header="Thời gian"  Binding="{Binding CreatedAt}"     Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Log -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#f8fafc" CornerRadius="12,12,0,0" Padding="14,12"
                                    BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                <TextBlock Text="📋 Log thao tác nhân viên" FontSize="14" FontWeight="Bold" Foreground="#1e293b"/>
                            </Border>
                            <Border Grid.Row="1" Padding="12,8" BorderBrush="#f1f5f9" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CbFilterLogStaff" Width="150" Style="{StaticResource FilterCombo}"
                                              Margin="0,0,10,0" SelectionChanged="CbFilterLogStaff_Changed"/>
                                    <TextBlock Text="Loại:" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CbFilterLogType" Width="140" Style="{StaticResource FilterCombo}"
                                              SelectionChanged="CbFilterLogStaff_Changed"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="DgLogs" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="White" AlternatingRowBackground="#fafafa"
                                      SelectionMode="Single" CanUserResizeRows="False">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DgHeader}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nhân viên"  Binding="{Binding StaffName}"      Width="120"/>
                                    <DataGridTextColumn Header="Chi nhánh"  Binding="{Binding BranchName}"     Width="100"/>
                                    <DataGridTextColumn Header="Thao tác"   Binding="{Binding ActionTypeText}" Width="110"/>
                                    <DataGridTextColumn Header="Mô tả"      Binding="{Binding Description}"    Width="*"/>
                                    <DataGridTextColumn Header="Thời gian"  Binding="{Binding Timestamp}"      Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>

<Window x:Class="DoAnQuanLyQuanAnAI.QRPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán QR"
        WindowState="Maximized"
        Background="White"
        FontFamily="Segoe UI">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Logo ngân hàng -->
            <TextBlock Text="🏦 VietinBank — Chuyển khoản nhanh"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1a3c8f"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Số tiền -->
            <Border Background="#f0fdf4" CornerRadius="16"
                    Padding="40,20" Margin="0,0,0,16"
                    BorderBrush="#16a34a" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="SỐ TIỀN CẦN THANH TOÁN"
                               FontSize="16" Foreground="#5a6282"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtAmount"
                               Text="0 đ"
                               FontSize="52" FontWeight="Bold"
                               Foreground="#16a34a"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Trạng thái tải QR -->
            <TextBlock x:Name="TxtQrStatus"
                       Text="⏳ Đang tải mã QR..."
                       FontSize="13"
                       Foreground="#5a6282"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       MaxWidth="320"/>

            <!-- Ảnh QR -->
            <Border Background="White" Padding="20"
                    BorderBrush="#e2e6f0" BorderThickness="1"
                    CornerRadius="16" Margin="0,0,0,20">
                <StackPanel>
                    <Image x:Name="QrImage"
                           Width="280" Height="280"
                           HorizontalAlignment="Center"/>
                    <TextBlock Text="Quét mã bằng app ngân hàng, MoMo, ZaloPay, VNPay"
                               FontSize="13" Foreground="#5a6282"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="280"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thông tin tài khoản -->
            <Border Background="#f5f6fa" CornerRadius="12"
                    Padding="24,16" Margin="0,0,0,16"
                    Width="380">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Chủ tài khoản:"
                                   Foreground="#5a6282" FontSize="14"/>
                        <TextBlock Text="TRAN PHUONG VINH"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#1a1f36"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Số tài khoản:"
                                   Foreground="#5a6282" FontSize="14"/>
                        <TextBlock Text="108876927706"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#1a1f36"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Ngân hàng:"
                                   Foreground="#5a6282" FontSize="14"/>
                        <TextBlock Text="VietinBank"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="#1a3c8f"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Nội dung chuyển khoản -->
            <Border Background="#eff6ff" CornerRadius="10"
                    Padding="16,10" Margin="0,0,0,24"
                    Width="380">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Nội dung CK: "
                               Foreground="#5a6282" FontSize="14"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtInvoiceNo"
                               FontWeight="Bold" FontSize="15"
                               Foreground="#3b6ef8"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Nút đóng -->
            <Button x:Name="BtnClose"
                    Content="✅ Khách đã thanh toán — Đóng"
                    Click="BtnClose_Click"
                    Background="#16a34a" Foreground="White"
                    FontSize="16" FontWeight="Bold"
                    Padding="40,14" BorderThickness="0"
                    Cursor="Hand" HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Window>

<Application x:Class="DoAnQuanLyQuanAnAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgColor" Color="#f5f6fa"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#ffffff"/>
        <SolidColorBrush x:Key="SurfaceAltColor" Color="#f0f2f8"/>
        <SolidColorBrush x:Key="BorderColor" Color="#e2e6f0"/>
        <SolidColorBrush x:Key="TextColor" Color="#1a1f36"/>
        <SolidColorBrush x:Key="TextSubColor" Color="#5a6282"/>
        <SolidColorBrush x:Key="TextMutedColor" Color="#9aa0b8"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3b6ef8"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#16a34a"/>
        <SolidColorBrush x:Key="DangerColor" Color="#dc2626"/>
        <SolidColorBrush x:Key="DangerLightColor" Color="#fee2e2"/>

        <LinearGradientBrush x:Key="LoginBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1e2d6b" Offset="0.0" />
            <GradientStop Color="#2a3d8f" Offset="0.5" />
            <GradientStop Color="#1a6b9a" Offset="1.0" />
        </LinearGradientBrush>
    </Application.Resources>
</Application>